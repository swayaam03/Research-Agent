# ============================================
# AI Research Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to version control.
# ============================================

# -------------- LLM Provider (OpenRouter) --------------
# Get your free API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The model to use via OpenRouter (free models have ":free" suffix)
# Browse available free models: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# OpenRouter API base URL (do not change unless you know what you're doing)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -------------- Search Provider (Tavily) --------------
# Get your free API key from: https://tavily.com/ (1000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# -------------- Application Settings --------------
# The port for the FastAPI backend server
APP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum number of search results per query
MAX_SEARCH_RESULTS=5

# Maximum number of web pages to extract content from
MAX_PAGES_TO_READ=3

# Maximum research iterations (analyzer loop-back limit)
MAX_RESEARCH_ITERATIONS=2
